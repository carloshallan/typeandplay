---
import { SITE, withBase } from "../lib/site"

const inBlog = Astro.url.pathname.startsWith(withBase("/blog"))
---

<!-- Floating pills instead of a bar, so the page starts at the top of the window: the
     page's own lead on the left (the blog's title and search), the logo and links on the
     right. They tuck away while you scroll down to read and come back when you scroll up. -->
<header class="site-header" id="site-header">
  {
    Astro.slots.has("lead") && (
      <div class="header-lead">
        <slot name="lead" />
      </div>
    )
  }
  <div class="header-pills">
    <a class="header-pill brand" href={withBase("/")} aria-label="type & play, início">
      <span class="brand-mark"><img src={withBase("/logo.svg")} alt="" width="40" height="40" /></span>
      <span class="wordmark">
        <span class="w-type">type</span>{" "}<span class="w-amp">&amp;</span>{" "}<span class="w-play">play</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Principal">
      <a class="header-pill nav-pill" href={withBase("/blog/")} aria-current={inBlog ? "page" : undefined}>Blog</a>
      <a class="header-pill nav-pill" href={SITE.channelUrl} target="_blank" rel="noopener">
        YouTube <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")
  const SHOW_ABOVE = 120
  const NUDGE = 6
  let lastY = window.scrollY

  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY
      if (!header || Math.abs(y - lastY) < NUDGE) return
      header.classList.toggle("is-tucked", y > SHOW_ABOVE && y > lastY)
      lastY = y
    },
    { passive: true }
  )
</script>
