---
import { SITE, withBase } from "../lib/site"

const inPosts = Astro.url.pathname.startsWith(withBase("/posts"))
---

<header class="site-header">
  <a class="brand" href={withBase("/")} aria-label="type & play, início">
    <img src={withBase("/logo.svg")} alt="" width="36" height="36" />
    <span class="wordmark">
      <span class="w-type">type</span>{" "}<span class="w-amp">&amp;</span>{" "}<span class="w-play">play</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Principal">
    <a class="nav-link" href={withBase("/posts/")} aria-current={inPosts ? "page" : undefined}>Textos</a>
    <a class="nav-pill" href={SITE.channelUrl} target="_blank" rel="noopener">
      YouTube <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
