---
import Base from "../layouts/Base.astro"
import { withBase } from "../lib/site"
---

<Base title="Fim de jogo" noindex>
  <main class="stage is-lost">
    <section class="hero">
      <p class="hud">Erro 404 · Fim de jogo</p>
      <h1>Esta página não foi <em>salva</em>.<span class="caret" aria-hidden="true"></span></h1>
      <p class="lede">O endereço pode ter mudado, ou o texto ainda não foi escrito.</p>
      <div class="actions">
        <a class="button" href={withBase("/")}><span class="play" aria-hidden="true">▶</span> Continuar do início</a>
        <a class="quiet" href={withBase("/blog/")}>Ir para o blog</a>
      </div>
    </section>
  </main>
</Base>
