---
import { render } from "astro:content"
import { Image, getImage } from "astro:assets"
import Base from "../../layouts/Base.astro"
import YouTube from "../../components/YouTube.astro"
import { formatDate, getPosts, padNumber, postUrl, type Post } from "../../lib/posts"
import { SITE } from "../../lib/site"
import "../../styles/post.css"

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] }
  }))
}

interface Props {
  post: Post
  newer?: Post
  older?: Post
}

const { post, newer, older } = Astro.props
const { title, description, date, cover, coverAlt, game, platform, year, draft } = post.data
const { Content } = await render(post)
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: "jpg" })).src : undefined
const cartridge = [game, platform, year].filter(Boolean).join(" · ")
const SAVE_BLOCKS = 10
---

<Base title={title} description={description} image={shareImage} tone="paper" type="article">
  <main class="post">
    <header class="post-head">
      <p class="hud">
        Memória {padNumber(post.number)} · <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {draft && " · Rascunho"}
      </p>
      <h1>{title}</h1>
      {description && <p class="post-lede">{description}</p>}
      <p class="post-meta">
        {cartridge && <span class="cartridge">{cartridge}</span>}
        <span>{post.minutes} min de leitura</span>
      </p>
    </header>

    {
      cover && (
        <Image
          class="post-cover"
          src={cover}
          alt={coverAlt ?? ""}
          widths={[640, 960, 1440]}
          sizes="(max-width: 800px) 100vw, (min-width: 1600px) 870px, 690px"
          loading="eager"
        />
      )
    }

    <div class="prose">
      <Content components={{ YouTube }} />
    </div>

    <footer class="post-end">
      <div class="saved" aria-hidden="true">
        <span class="saved-bar">{Array.from({ length: SAVE_BLOCKS }, () => <i />)}</span>
        <span class="saved-label">Memória salva.</span>
      </div>

      {
        (older || newer) && (
          <nav class="post-nav" aria-label="Outros textos">
            {older && (
              <a class="post-nav-link is-older" href={postUrl(older)}>
                <span class="post-nav-dir">← Memória anterior</span>
                <span class="post-nav-title">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a class="post-nav-link is-newer" href={postUrl(newer)}>
                <span class="post-nav-dir">Próxima memória →</span>
                <span class="post-nav-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      <a class="button" href={SITE.channelUrl} target="_blank" rel="noopener">
        <span class="play" aria-hidden="true">▶</span> Assistir no YouTube
      </a>
    </footer>
  </main>
</Base>
