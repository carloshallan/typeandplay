---
import { render } from "astro:content"
import { Image, getImage } from "astro:assets"
import Base from "../../layouts/Base.astro"
import YouTube from "../../components/YouTube.astro"
import { categoryUrl, formatDate, getPosts, padNumber, postUrl, type Post } from "../../lib/posts"
import { SITE } from "../../lib/site"
import "../../styles/post.css"

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] }
  }))
}

interface Props {
  post: Post
  newer?: Post
  older?: Post
}

const { post, newer, older } = Astro.props
const { title, description, date, cover, coverAlt, categories, game, platform, year, draft } = post.data
const { Content } = await render(post)
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: "jpg" })).src : undefined
const cartridge = [game, platform, year].filter(Boolean).join(" · ")
const SAVE_BLOCKS = 10
---

<Base title={title} description={description} image={shareImage} tone="reader" type="article">
  <main class="post-page">
    {/* With a cover, the cover opens the page, edge to edge, and the head sits over its
        lower part on its own card. Covers are 1600×700 (see AGENTS.md). */}
    <div class:list={["post-hero", { "has-cover": cover }]}>
      {
        cover && (
          <Image
            class="post-hero-cover"
            src={cover}
            alt={coverAlt ?? ""}
            widths={[800, 1200, 1600]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      <header class="post post-head">
        <div class="post-head-card">
          <p class="hud">
            Memória {padNumber(post.number)} · <time datetime={date.toISOString()}>{formatDate(date)}</time>
            {draft && " · Rascunho"}
          </p>
          <h1>{title}</h1>
          {description && <p class="post-lede">{description}</p>}
          <p class="post-byline">
            por <a href={SITE.author.url} rel="author">{SITE.author.name}</a>
          </p>
          <p class="post-meta">
            {cartridge && <span class="cartridge">{cartridge}</span>}
            <span>{post.minutes} min de leitura</span>
          </p>
          {
            categories.length > 0 && (
              <nav class="category-chips" aria-label="Categorias deste texto">
                {categories.map(name => <a href={categoryUrl(name)}>{name}</a>)}
              </nav>
            )
          }
        </div>
      </header>
    </div>

    <div class="post">
      <div class="prose">
        <Content components={{ YouTube }} />
      </div>

      <footer class="post-end">
        <div class="saved" data-save-blocks={SAVE_BLOCKS} aria-hidden="true">
          <span class="saved-bar">{Array.from({ length: SAVE_BLOCKS }, (_, i) => <i style={`--i: ${i}`} />)}</span>
          <span class="saved-label">
            <span class="saved-label-saving">Salvando memória</span>
            <span class="saved-label-done">Memória salva.</span>
          </span>
        </div>

        {
          (older || newer) && (
            <nav class="post-nav" aria-label="Outros textos">
              {older && (
                <a class="post-nav-link is-older" href={postUrl(older)}>
                  <span class="post-nav-dir">← Memória anterior</span>
                  <span class="post-nav-title">{older.data.title}</span>
                </a>
              )}
              {newer && (
                <a class="post-nav-link is-newer" href={postUrl(newer)}>
                  <span class="post-nav-dir">Próxima memória →</span>
                  <span class="post-nav-title">{newer.data.title}</span>
                </a>
              )}
            </nav>
          )
        }

        <a class="button" href={SITE.channelUrl} target="_blank" rel="noopener">
          <span class="play" aria-hidden="true">▶</span> Assistir no YouTube
        </a>
      </footer>
    </div>
  </main>
</Base>

<script>
  // Plays the save once, when the reader reaches the end of the text.
  const save = document.querySelector<HTMLElement>(".saved")
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  if (save && !still && "IntersectionObserver" in window) {
    const blocks = Number(save.dataset.saveBlocks ?? 10)
    save.classList.add("is-armed")
    const observer = new IntersectionObserver(
      entries => {
        if (!entries.some(entry => entry.isIntersecting)) return
        observer.disconnect()
        save.classList.add("is-saving")
        window.setTimeout(() => save.classList.add("is-saved"), blocks * 120 + 450)
      },
      { threshold: 1 }
    )
    observer.observe(save)
  }
</script>
