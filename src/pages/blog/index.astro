---
import Base from "../../layouts/Base.astro"
import BlogShelf from "../../components/BlogShelf.astro"
import BlogHeaderLead from "../../components/BlogHeaderLead.astro"
import { getCategories, getPosts } from "../../lib/posts"
import "../../styles/pixel-trial.css"

const posts = await getPosts()
---

<Base tone="reader" title="Blog" description="O blog do type & play: todos os textos, do mais novo ao mais antigo.">
  <BlogHeaderLead slot="header-lead" title="Blog" />
  <BlogShelf posts={posts} categories={getCategories(posts)} />
</Base>
